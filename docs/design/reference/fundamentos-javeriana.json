{
  "source": "https://www.javeriana.edu.co/carrera-derecho",
  "scope": "Declaraciones CSS leídas durante el análisis; no implican uso visible de todos los tokens. Valores rem convertibles a px solo según tamaño de raíz.",
  "rules": [
    {
      "selector": ":root",
      "values": {
        "--transition": "0.3s",
        "--max-width": "87.5rem",
        "--max-width-sm": "36rem",
        "--max-width-md": "48rem",
        "--max-width-lg": "62rem",
        "--max-width-xl": "75rem",
        "--spacing-3xs": "0.125rem",
        "--spacing-2xs": "0.25rem",
        "--spacing-xs": "0.5rem",
        "--spacing-sm": "0.75rem",
        "--spacing-md": "1rem",
        "--spacing-lg": "1.5rem",
        "--spacing-xl": "2.375rem",
        "--spacing-2xl": "3rem",
        "--spacing-3xl": "4rem",
        "--spacing-4xl": "5rem",
        "--border-radius": "0.875rem",
        "--border-radius-xs": "0.125rem",
        "--border-radius-sm": "0.25rem",
        "--border-radius-md": "0.5rem",
        "--border-radius-lg": "1rem",
        "--border-radius-xl": "1.25rem",
        "--shadow-sm": "0 0.0625rem 0.1875rem rgba(var(--neutral-100-rgb), 0.12)",
        "--shadow-md": "0 0.25rem 0.375rem rgba(var(--neutral-100-rgb), 0.1)",
        "--shadow-lg": "0 0.625rem 1.875rem rgba(var(--neutral-100-rgb), 0.2)",
        "--shadow-xl": "0 1.25rem 2.5rem rgba(var(--neutral-100-rgb), 0.12)",
        "--btn-ripple-duration": "0.6s",
        "--btn-ripple-color-light": "rgba(255, 255, 255, 0.3)",
        "--btn-ripple-color-dark": "rgba(0, 0, 0, 0.15)",
        "--btn-transition-duration": "0.3s",
        "--btn-hover-y-offset": "-0.125rem",
        "--btn-shadow-hover": "0 0.25rem 0.5rem rgba(0, 0, 0, 0.1)",
        "--btn-shadow-hover-dark": "0 0.25rem 0.75rem rgba(0, 0, 0, 0.25)"
      }
    },
    {
      "selector": ":root",
      "values": {
        "--font-family": "'Raleway', sans-serif",
        "--font-size-principal-title": "2.25rem",
        "--font-size-title": "1.75rem",
        "--font-size-subtitle": "1.375rem",
        "--font-size-caption": "1.125rem",
        "--font-size-heading": "1rem",
        "--font-size-paragraph": "0.875rem",
        "--font-size-small": "0.6875rem",
        "--font-size-xs": "0.5625rem",
        "--font-weight-thin": "100",
        "--font-weight-light": "300",
        "--font-weight-regular": "400",
        "--font-weight-medium": "500",
        "--font-weight-bold": "700",
        "--line-height-base": "1.5",
        "--line-height-heading": "1.2",
        "--letter-spacing-normal": "normal",
        "--letter-spacing-wide": "0.05em",
        "--icon-size-2xs": "0.75rem",
        "--icon-size-xs": "0.875rem",
        "--icon-size-sm": "1.125rem",
        "--icon-size-md": "1.5rem",
        "--icon-size-lg": "2.25rem",
        "--icon-size-xl": "2.5rem",
        "--icon-size-2xl": "3.25rem",
        "--icon-size-3xl": "4.25rem",
        "--icon-logo-big": "10rem"
      }
    }
  ]
}
